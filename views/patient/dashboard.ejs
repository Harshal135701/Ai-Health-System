<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Dashboard</title>

    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body>

    <%- include("../partials/sidebar") %>

    <div class="main-content">

        <%- include("../partials/navbar") %>

        <!-- Welcome Section -->

        <a href="/patient/ai-symptom-checker">Check Symptoms Through Ai</a>

        <section class="welcome-section">

            <div>

                <h1>Welcome, <%= patient.name %> 👋</h1>

                <p>
                    Manage your appointments and stay updated with your healthcare.
                </p>

            </div>

        </section>

        <!-- Dashboard Cards -->

        <section class="cards">

            <div class="card">

                <div class="card-icon blue">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div>

                    <h3>Total Appointments</h3>

                    <h2><%= totalAppointments %></h2>

                </div>

            </div>

            <div class="card">

                <div class="card-icon orange">

                    <i class="fa-solid fa-clock"></i>

                </div>

                <div>

                    <h3>Pending</h3>

                    <h2><%= pendingCount %></h2>

                </div>

            </div>

            <div class="card">

                <div class="card-icon green">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <h3>Confirmed</h3>

                    <h2><%= confirmedCount %></h2>

                </div>

            </div>

            <div class="card">

                <div class="card-icon red">

                    <i class="fa-solid fa-circle-xmark"></i>

                </div>

                <div>

                    <h3>Rejected</h3>

                    <h2><%= rejectedCount %></h2>

                </div>

            </div>

        </section>

        <!-- Upcoming Appointment -->

        <!-- <section class="upcoming-section">

            <div class="section-header">

                <h2>Upcoming Appointment</h2>

            </div>

            <% if(upcomingAppointment){ %>

                <div class="upcoming-card">

                    <div class="doctor-image">

                        <i class="fa-solid fa-user-doctor"></i>

                    </div>

                    <div class="doctor-info">

                        <h3>
                            Dr.
                            <%= upcomingAppointment.doctorId.userId.name %>
                        </h3>

                        <p>

                            <strong>Specialization :</strong>

                            <%= upcomingAppointment.doctorId.specialization %>

                        </p>

                        <p>

                            <strong>Date :</strong>

                            <%= upcomingAppointment.appointmentDate.toDateString() %>

                        </p>

                        <p>

                            <strong>Time :</strong>

                            <%= upcomingAppointment.formattedStartTime %>

                                -

                                <%= upcomingAppointment.formattedEndTime %>

                        </p>

                    </div>

                </div>

                <% } else { %>

                    <div class="empty-card">

                        <i class="fa-solid fa-calendar-xmark"></i>

                        <h3>No Upcoming Appointment</h3>

                        <p>
                            Book an appointment to see it here.
                        </p>

                    </div>

                    <% } %>

        </section> -->

        <!-- Recent Appointments -->

        <section class="recent-section">

            <div class="section-header">

                <h2>Recent Appointments</h2>

            </div>

            <% if(recentAppointments.length===0){ %>

                <div class="empty-card">

                    <i class="fa-solid fa-folder-open"></i>

                    <h3>No Appointments Found</h3>

                </div>

                <% } else { %>

                    <table class="appointment-table">

                        <thead>

                            <tr>

                                <th>Doctor</th>

                                <th>Specialization</th>

                                <th>Symptoms</th>

                                <th>Date</th>

                                <th>Time</th>

                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% recentAppointments.forEach(function(appointment){ %>

                                <tr>

                                    <td>

                                        Dr.
                                        <%= appointment.doctorId.userId.name %>

                                    </td>

                                    <td>

                                        <%= appointment.doctorId.specialization %>

                                    </td>

                                    <td>

                                        <%= appointment.symptoms %>

                                    </td>

                                    <td>

                                        <%= appointment.appointmentDate.toDateString() %>

                                    </td>

                                    <td>

                                        <%= appointment.formattedStartTime %>

                                            -

                                            <%= appointment.formattedEndTime %>

                                    </td>

                                    <td>

                                        <% if(appointment.appointmentStatus==="confirmed"){ %>

                                            <span class="status confirmed">

                                                Confirmed

                                            </span>

                                            <% } else if(appointment.appointmentStatus==="pending"){ %>

                                                <span class="status pending">

                                                    Pending

                                                </span>

                                                <% } else if(appointment.appointmentStatus==="rejected"){ %>

                                                    <span class="status rejected">

                                                        Rejected

                                                    </span>

                                                    <% } else { %>

                                                        <span class="status cancelled">

                                                            <%= appointment.appointmentStatus %>

                                                        </span>

                                                        <% } %>

                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>

                    <% } %>

        </section>

    </div>

</body>

</html>