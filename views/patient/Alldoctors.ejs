<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h2>Find Doctors</h2>

    <form action="/patient/alldoctors" method="GET">

        <label>Specialization</label>
        <select name="specialization">

            <option value="">All Specializations</option>

            <option value="Cardiologist" <%=filters.specialization==="Cardiologist" ? "selected" : "" %>>
                Cardiologist
            </option>

            <option value="Dermatologist" <%=filters.specialization==="Dermatologist" ? "selected" : "" %>>
                Dermatologist
            </option>

            <option value="Neurologist" <%=filters.specialization==="Neurologist" ? "selected" : "" %>>
                Neurologist
            </option>

            <option value="Orthopedic" <%=filters.specialization==="Orthopedic" ? "selected" : "" %>>
                Orthopedic
            </option>

            <option value="Pediatrician" <%=filters.specialization==="Pediatrician" ? "selected" : "" %>>
                Pediatrician
            </option>

            <option value="Psychiatrist" <%=filters.specialization==="Psychiatrist" ? "selected" : "" %>>
                Psychiatrist
            </option>

            <option value="ENT Specialist" <%=filters.specialization==="ENT Specialist" ? "selected" : "" %>>
                ENT Specialist
            </option>

            <option value="General Physician" <%=filters.specialization==="General Physician" ? "selected" : "" %>>
                General Physician
            </option>

        </select>

        <br><br>

        <label>Minimum Experience</label>
        <input type="number" name="minExperience" placeholder="Years" value="<%= filters.minExperience || '' %>">

        <br><br>

        <label>Consultation Fee</label>

        <select name="feeRange">

            <option value="">Any Fee</option>

            <option value="0-500" <%=filters.feeRange==="0-500" ? "selected" : "" %>>
                ₹0 - ₹500
            </option>

            <option value="500-1000" <%=filters.feeRange==="500-1000" ? "selected" : "" %>>
                ₹500 - ₹1000
            </option>

            <option value="1000-2000" <%=filters.feeRange==="1000-2000" ? "selected" : "" %>>
                ₹1000 - ₹2000
            </option>

            <option value="2000+" <%=filters.feeRange==="2000+" ? "selected" : "" %>>
                Above ₹2000
            </option>

        </select>

        <br><br>

        <button type="submit">
            Search Doctors
        </button>

        <a href="/patient/alldoctors">
            <button type="button">
                Reset
            </button>
        </a>

    </form>

    <hr>
    <hr>
    <a href="/patient/Alldoctors">Clear Filter</a>

    <% if(doctors.length===0){ %>

        <h3>No Doctors Found</h3>

        <% } %>

            <% doctors.forEach(function(doctor){ %>

                <div style="border:1px solid black;padding:15px;margin-bottom:20px;">

                    <h3>
                        <%= doctor.userId.name %>
                    </h3>

                    <p>
                        <strong>Phone :</strong>
                        <%= doctor.userId.phoneNo %>
                    </p>

                    <p>
                        <strong>Specialization :</strong>
                        <%= doctor.specialization %>
                    </p>

                    <p>
                        <strong>Experience :</strong>
                        <%= doctor.experience %> Years
                    </p>

                    <p>
                        <strong>Consultation Fee :</strong>
                        ₹<%= doctor.consultationFee %>
                    </p>

                    <a href="/patient/doctors/<%= doctor.userId._id %>">
                        View Doctor
                    </a>

                </div>

                <% }) %>
                    <hr>

                    <div style="display:flex;justify-content:center;align-items:center;gap:10px;margin:30px 0;">

                        <!-- Previous -->

                        <% if(currentPage> 1){ %>

                            <a href="?page=<%= currentPage-1 %>
        <% if(filters.specialization){ %>&specialization=<%= filters.specialization %><% } %>
        <% if(filters.minExperience){ %>&minExperience=<%= filters.minExperience %><% } %>
        <% if(filters.feeRange){ %>&feeRange=<%= filters.feeRange %><% } %>">
                                << Previous </a>

                                    <% } %>


                                        <!-- Page Numbers -->

                                        <% for(let i=1;i<=totalPages;i++){ %>

                                            <% if(i===currentPage){ %>

                                                <strong style="padding:8px 15px;
                       border:1px solid black;
                       background:black;
                       color:white;
                       border-radius:5px;">

                                                    <%= i %>

                                                </strong>

                                                <% } else { %>

                                                    <a href="?page=<%= i %>
                <% if(filters.specialization){ %>&specialization=<%= filters.specialization %><% } %>
                <% if(filters.minExperience){ %>&minExperience=<%= filters.minExperience %><% } %>
                <% if(filters.feeRange){ %>&feeRange=<%= filters.feeRange %><% } %>" style="padding:8px 15px;
                       border:1px solid black;
                       border-radius:5px;
                       text-decoration:none;">

                                                        <%= i %>

                                                    </a>

                                                    <% } %>

                                                        <% } %>


                                                            <!-- Next -->

                                                            <% if(currentPage < totalPages){ %>

                                                                <a href="?page=<%= currentPage+1 %>
        <% if(filters.specialization){ %>&specialization=<%= filters.specialization %><% } %>
        <% if(filters.minExperience){ %>&minExperience=<%= filters.minExperience %><% } %>
        <% if(filters.feeRange){ %>&feeRange=<%= filters.feeRange %><% } %>">
                                                                    Next >>
                                                                </a>

                                                                <% } %>

                    </div>
</body>

</html>