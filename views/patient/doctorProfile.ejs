<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h2>Complete Doctor Profile</h2>
    <li>
        specialization -
        <%=doctor.specialization%>
    </li>
    <li>
        experience -
        <%=doctor.experience%>
    </li>
    <li>
        hospital -
        <%=doctor.hospital%>
    </li>
    <li>
        education-
        <%=doctor.education%>
    </li>
    <li>
        consultationFee-
        <%=doctor.consultationFee%>
    </li>
    <li>
        rating-
        <%=doctor.rating%>
    </li>
    <li>
        Total Reviews -
        <%= doctor.totalReviews %>
    </li>

    <br>

    <h3>Patient Reviews</h3>

    <% if(reviews.length===0){ %>

        <p>No reviews yet.</p>

        <% } else { %>

            <% reviews.forEach(function(review){ %>

                <hr>

                <h4>
                    <%= review.patientId.name %>
                </h4>

                <p>
                    Rating :
                    ⭐ <%= review.rating %> / 5
                </p>

                <p>
                    <%= review.comment || "No comment provided." %>
                </p>

                <small>
                    <%= review.createdAt.toLocaleDateString("en-IN") %>
                </small>

                <% }) %>

                    <% } %>

                        <br>

                        <a href="/patient/<%=doctor.userId._id%>/appointment/booking">
                            Book Appointment
                        </a>
</body>

</html>