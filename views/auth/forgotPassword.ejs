<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password | AI Health Assistant</title>


    <link rel="stylesheet" href="/css/forgot-password.css">


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">


</head>


<body>
    <div class="page">



        <!-- LEFT SECTION -->


        <section class="left-side">


            <div class="hero">


                <div class="logo">

                    <i class="fa-solid fa-heart-pulse"></i>

                    AI Health Assistant

                </div>



                <h1>

                    Secure Account
                    <span>Recovery</span>

                </h1>



                <p>

                    Don't worry, we will help you recover
                    your account securely. Enter your email
                    and we will send you an OTP verification code.

                </p>




                <div class="security-box">


                    <i class="fa-solid fa-shield-halved"></i>


                    Secure OTP Verification


                </div>



                <div class="security-box">


                    <i class="fa-solid fa-lock"></i>


                    Your information stays protected


                </div>




            </div>



        </section>







        <!-- RIGHT SECTION -->


        <section class="right-side">


            <div class="forgot-card">


                <div class="icon">


                    <i class="fa-solid fa-key"></i>


                </div>




                <h2>

                    Forgot Password?

                </h2>




                <p>

                    Enter your registered email address
                    to receive OTP.

                </p>




                <form action="/forgot-password" method="post">


                    <% if (typeof message !=='undefined' ) { %>

                        <p class="form-message message-error">
                            <%= message %>
                        </p>

                        <% } %>

                            <div class="input-group">


                                <i class="fa-solid fa-envelope"></i>


                                <input type="email" name="email" placeholder="Email Address" required>


                            </div>




                            <button type="submit" class="otp-btn">


                                Send OTP

                                <i class="fa-solid fa-paper-plane"></i>


                            </button>



                </form>





                <div class="back-login">


                    Remember your password?


                    <a href="/login">

                        Login

                    </a>


                </div>




            </div>



        </section>



    </div>



</body>


</html>