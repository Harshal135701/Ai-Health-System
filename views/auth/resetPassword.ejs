<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
</head>

<body>

    <h2>Reset Password</h2>


    <form action="/reset-password" method="post">


        <input 
            type="hidden"
            name="email"
            value="<%= email %>"
        >


        New Password:

        <input
            type="password"
            name="newPassword"
            placeholder="Enter new password"
            required
        >


        <br><br>


        <button type="submit">
            Reset Password
        </button>


    </form>


</body>

</html>