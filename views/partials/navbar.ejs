<script>
    window.notificationConfig = {
        baseUrl: "/patient/notifications"
    };
</script>

<nav class="navbar">

    <!-- Left Section -->
    <div class="navbar-left">

        <form action="/patient/alldoctors" method="GET" class="search-box">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text" name="doctorName" placeholder="Search doctors..."
                value="<%= typeof filters !== 'undefined' ? (filters.doctorName || '') : '' %>">

        </form>

    </div>

    <!-- Right Section -->
    <div class="navbar-right">

        <!-- Notification -->
        <div class="notification">

            <button class="notification-btn">

                <i class="fa-solid fa-bell"></i>

                <span class="badge" id="notificationBadge">0</span>

            </button>

            <div class="notification-dropdown">

                <div class="notification-header">

                    <h3>Notifications</h3>

                    <a href="/patient/notifications">View All</a>

                </div>

                <div class="notification-list" id="notificationList">

                    <div class="notification-item">

                        <div class="notification-icon success">

                            <i class="fa-solid fa-bell"></i>

                        </div>

                        <div class="notification-content">

                            <h4>No Notifications</h4>

                            <p>You don't have any notifications yet.</p>

                            <span>Just Now</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- User -->
        <div class="user-info">

            <img src="<%= user.profilePic %>" alt="Profile">

            <div>

                <h4>
                    <%= user.name %>
                </h4>

                <p>Patient</p>

            </div>

        </div>

    </div>

</nav>

<script src="/socket.io/socket.io.js"></script>

<script>
    window.notificationConfig = {
        baseUrl: "/patient/notifications",
        defaultRedirect: "/patient/appointments"
    };

    window.currentUser = {
        id: "<%= user._id %>",
        role: "<%= user.role %>"
    };
</script>

<script src="/js/notification.js"></script>
<script src="/js/patientNavbar.js"></script>