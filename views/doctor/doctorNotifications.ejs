<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Notifications</title>

    <link rel="stylesheet" href="/css/doctorNavbar.css">
    <link rel="stylesheet" href="/css/doctorSidebar.css">
    <link rel="stylesheet" href="/css/doctorNotifications.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>

    <%- include("../partials/doctorNavbar") %>

    <div class="dashboard-container">

        <%- include("../partials/doctorSidebar") %>

        <div class="main-content">

            <h1>All Notifications</h1>

            <% if(notifications.length===0){ %>

                <div class="empty">

                    <i class="fa-solid fa-bell-slash"></i>

                    <p>No notifications found.</p>

                </div>

            <% } else { %>

                <div class="notification-container">

                    <% notifications.forEach(notification=>{ %>

                        <a
                            href="<%= notification.redirectUrl || '/doctor/appointments' %>"
                            class="notification-card <%= notification.isRead ? '' : 'unread' %>">

                            <div class="left">

                                <i class="fa-solid fa-calendar-check"></i>

                            </div>

                            <div class="right">

                                <h3>

                                    <%= notification.title %>

                                </h3>

                                <p>

                                    <%= notification.message %>

                                </p>

                                <span>

                                    <%= notification.createdAt.toLocaleString() %>

                                </span>

                            </div>

                        </a>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </div>

</body>

</html>